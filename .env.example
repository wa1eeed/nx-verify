# NX Verify: environment template. Never commit real values.
# Rule 10: no provider credentials here and none in the database. Only KMS references.

# Admin connection used to run migrations and to provision roles.
# The application never uses this connection.
NX_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nx_verify

# Passwords for the three database roles created by migration 0001.
# The migration creates the roles, the migrate runner assigns the passwords.
NX_MIGRATOR_PASSWORD=
NX_APP_PASSWORD=
NX_RETENTION_PASSWORD=
NX_OPERATOR_PASSWORD=

# Runtime connections. Rule 12: the application role owns nothing and never bypasses RLS.
NX_APP_DATABASE_URL=postgres://nx_app@localhost:5432/nx_verify
NX_RETENTION_DATABASE_URL=postgres://nx_retention@localhost:5432/nx_verify

# Which providers are running. The only difference between sandbox and live.
#   stub                        the built in stub, for sandbox and tests
#   wathq:https://api.example   a real provider at a base url
# Several may be listed, separated by commas, so a second provider can be carried ready
# but inactive.
NX_PROVIDERS=stub

# Root key for the per tenant HMAC, encryption and signing keys. A KMS supplies this in
# every real environment; the variable exists for local work.
NX_MASTER_KEY=

# Several versions, for rehearsing a rotation locally. The highest is the one written
# with, and the others stay readable until the rotation job has moved every row.
#   NX_MASTER_KEYS=1:<base64>,2:<base64>
NX_MASTER_KEYS=

# Development fallback for the console, used only when there is no session cookie.
# It refuses to work when NODE_ENV is production: a convenience that survives into a
# deployment is not a convenience.
NX_CONSOLE_TENANT_ID=
NX_CONSOLE_USER_ID=
NX_CONSOLE_ROLE=ADMIN

# The operator panel. A separate role, a separate connection and a separate token, so the
# screens that name providers cannot be reached from a subscriber session (rule 5).
NX_OPERATOR_DATABASE_URL=postgres://nx_operator@localhost:5432/nx_verify
NX_OPERATOR_TOKEN=
NX_OPERATOR_ID=nx-staff:your-name

# The worker needs both connections: the application one to do the work, and the operator
# one to read the list of workspaces and nothing else (ADR-056).

# Where the console lives. Printed on evidence documents, used as the address the identity
# provider redirects back to, and used in notification messages.
NX_CONSOLE_URL=http://localhost:3001

# Where the public evidence check lives. It appears as a code on every sealed document.
NX_PUBLIC_BASE_URL=https://verify.example.sa

# Single sign on. The provider is configured per subscriber in the console; this is only
# the store the client secret is read from (rule 10).
#   NX_SECRETS={"kms://tenants/acme/idp":{"clientSecret":"..."}}
NX_SECRETS=

# The key management service, and the secret manager. Both are required when NODE_ENV is
# production: the environment paths above refuse to run there (ADR-057).
#   NX_KMS_KEYS holds the encrypted data key for each readable version.
NX_KMS_ENDPOINT=
NX_KMS_TOKEN=
NX_KMS_KEYS=
NX_SECRETS_ENDPOINT=
NX_SECRETS_TOKEN=

# Mail, for notifications. Without an endpoint the worker simply does not run that job,
# and messages queue until one is configured.
NX_MAIL_ENDPOINT=
NX_MAIL_TOKEN=
NX_MAIL_FROM=

# The MCP server. One process is one subscriber, because the key fixes the workspace.
# The ceiling is in halalas and nothing the model sends can raise it.
NX_API_URL=http://localhost:3000
NX_API_KEY=
NX_MCP_SPEND_CEILING_HALALAS=50000

# Only used by docker compose, to initialise the database container.
NX_POSTGRES_PASSWORD=

# The image runs with NODE_ENV=production, where the environment paths for keys and
# secrets are refused. Set this to development for a local demonstration with
# NX_MASTER_KEY and NX_SECRETS, and leave it unset for anything real.
NODE_ENV=

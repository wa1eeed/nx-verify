# NX Verify: environment template. Never commit real values.
# Rule 10: no provider credentials here and none in the database. Only KMS references.

# Admin connection used to run migrations and to provision roles.
# The application never uses this connection.
NX_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nx_verify

# Passwords for the three database roles created by migration 0001.
# The migration creates the roles, the migrate runner assigns the passwords.
NX_MIGRATOR_PASSWORD=
NX_APP_PASSWORD=
NX_RETENTION_PASSWORD=

# Runtime connections. Rule 12: the application role owns nothing and never bypasses RLS.
NX_APP_DATABASE_URL=postgres://nx_app@localhost:5432/nx_verify
NX_RETENTION_DATABASE_URL=postgres://nx_retention@localhost:5432/nx_verify

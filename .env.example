# NX Verify: environment template. Never commit real values.
# Rule 10: no provider credentials here and none in the database. Only KMS references.

# Admin connection used to run migrations and to provision roles.
# The application never uses this connection.
NX_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nx_verify

# Passwords for the three database roles created by migration 0001.
# The migration creates the roles, the migrate runner assigns the passwords.
NX_MIGRATOR_PASSWORD=
NX_APP_PASSWORD=
NX_RETENTION_PASSWORD=
NX_OPERATOR_PASSWORD=

# Runtime connections. Rule 12: the application role owns nothing and never bypasses RLS.
NX_APP_DATABASE_URL=postgres://nx_app@localhost:5432/nx_verify
NX_RETENTION_DATABASE_URL=postgres://nx_retention@localhost:5432/nx_verify

# Which providers are running. The only difference between sandbox and live.
#   stub                        the built in stub, for sandbox and tests
#   wathq:https://api.example   a real provider at a base url
# Several may be listed, separated by commas, so a second provider can be carried ready
# but inactive.
NX_PROVIDERS=stub

# مزوّد الخدمات المصرفية المفتوحة يحتاج مضيفين: واحد يسك الرمز وآخر يجيب الأسئلة.
#   NX_OPENBANKING_PROVIDERS=bankdata:https://sandbox.example.com;https://auth.sandbox.example.com/oauth2/token
# والاعتماد نفسه في مخزن الأسرار لا هنا (القاعدة 10):
#   NX_SECRETS={"kms://tenants/acme/openbanking":{"clientId":"...","clientSecret":"..."}}
NX_OPENBANKING_PROVIDERS=

# Root key for the per tenant HMAC, encryption and signing keys. A KMS supplies this in
# every real environment; the variable exists for local work and is refused in production.
NX_MASTER_KEY=

# The same key, from a file, which production does accept (ADR-151). One base64 key on a
# line, or several `<version>:<base64>` lines; blank lines and `#` comments are ignored.
#
# Why a file where a variable is refused: a variable is readable by anything that can run
# `docker inspect`, read /proc/<pid>/environ, or look at the deployment tool's own form.
# A file at 0600 on a volume is readable by the process user and by root, which is the
# same audience that could read the process memory anyway. It is what already lets the
# sealed secret store hold every provider credential in production.
#
# The compose stack makes one on first start if it is absent, and says so loudly. A key
# service is still better: set NX_KMS_ENDPOINT and this is ignored.
NX_MASTER_KEY_FILE=

# Several versions, for rehearsing a rotation locally. The highest is the one written
# with, and the others stay readable until the rotation job has moved every row.
#   NX_MASTER_KEYS=1:<base64>,2:<base64>
NX_MASTER_KEYS=

# Development fallback for the console, used only when there is no session cookie.
# It refuses to work when NODE_ENV is production: a convenience that survives into a
# deployment is not a convenience.
NX_CONSOLE_TENANT_ID=
NX_CONSOLE_USER_ID=
NX_CONSOLE_ROLE=ADMIN

# The operator panel. A separate role, a separate connection and a separate sign in, so the
# screens that name providers cannot be reached from a subscriber session (rule 5). Staff
# sign in with their own accounts and an authenticator; the token makes the first owner at
# /operator/login and seals their sessions, so rotating it signs everybody out (ADR-117).
#
# A deployment refuses a token shorter than 32 random bytes (SEC-06):
#   openssl rand -base64 32
NX_OPERATOR_DATABASE_URL=postgres://nx_operator@localhost:5432/nx_verify
NX_OPERATOR_TOKEN=
# The name the provisioning scripts write to the audit trail.
NX_OPERATOR_ID=nx-staff:your-name

# The first owner of the administration panel, for a deployment made by a tool rather than
# by hand: there is no console there to run a command in and nobody to paste the token
# above (ADR-142). The worker makes these true at every start.
#
# Note the name. This is NOT NX_OPERATOR_PASSWORD, which is the password of the
# nx_operator DATABASE ROLE a few lines up. Two different secrets: one lives in a
# connection string, the other is typed into a sign in form by a person.
#
# The variable wins over the panel. Change the password here, redeploy, and that is the
# password; one changed inside the panel is overwritten at the next start, and every
# session opened under the old one ends. The authenticator is never touched, so two steps
# stay two steps across a redeployment.
NX_PANEL_OWNER_EMAIL=
NX_PANEL_OWNER_PASSWORD=
# Optional. «مالك المنصة» when absent.
NX_PANEL_OWNER_NAME=

# The worker needs both connections: the application one to do the work, and the operator
# one to read the list of workspaces and nothing else (ADR-056).

# The worker touches this file after every sweep, and its health check reads how old the
# file is (SEC-07). Unset means no heartbeat and no health check, which is right for a
# worker running in a terminal. docker compose sets it for you.
NX_WORKER_HEARTBEAT=

# The port the API listens on. The host is always 0.0.0.0.
PORT=3000

# The support address on the console's support screen. Unset falls back to support@nx.sa,
# which is wrong for any deployment that is not ours.
NX_SUPPORT_EMAIL=

# Where the readiness screen counts migrations. Only needed by an image whose layout differs
# from this repository; an unreadable path makes the screen report zero.
NX_MIGRATIONS_DIR=

# Where the console lives. Printed on evidence documents, used as the address the identity
# provider redirects back to, and used in notification messages.
NX_CONSOLE_URL=http://localhost:3001

# Where the public evidence check lives. It appears as a code on every sealed document.
NX_PUBLIC_BASE_URL=https://verify.example.sa
# Where the console answers. Shared profile links are built from it, so a wrong value
# produces links that look right and open nothing.
NX_CONSOLE_BASE_URL=http://localhost:3001

# Where subscribers send a bank transfer to top up their balance. Shown on the billing
# screen beside the reference they must quote. Left unset, the screen says so rather than
# printing an address that is not ours.
NX_BANK_ACCOUNT_NAME=
NX_BANK_NAME=
NX_BANK_IBAN=

# Single sign on. The provider is configured per subscriber in the console; this is only
# the store the client secret is read from (rule 10).
#   NX_SECRETS={"kms://tenants/acme/idp":{"clientSecret":"..."}}
NX_SECRETS=

# The key management service, and the secret manager. Both are required when NODE_ENV is
# production: the environment paths above refuse to run there (ADR-057).
#   NX_KMS_KEYS holds the encrypted data key for each readable version.
NX_KMS_ENDPOINT=
NX_KMS_TOKEN=
NX_KMS_KEYS=
NX_SECRETS_ENDPOINT=
NX_SECRETS_TOKEN=

# The data source credentials for the sandbox and for production are set from the
# administration panel (/operator/integration). Without a secret manager above, the panel
# writes them to this file, sealed with a key derived from the master key. Keep the file on
# a protected volume, back it up apart from the database, and never next to the master key.
# docker compose sets it for you.
NX_SECRETS_FILE=

# Mail, for notifications. Without an endpoint the worker simply does not run that job,
# and messages queue until one is configured.
NX_MAIL_ENDPOINT=
NX_MAIL_TOKEN=
NX_MAIL_FROM=

# The MCP server. One process is one subscriber, because the key fixes the workspace.
# The ceiling is in halalas and nothing the model sends can raise it.
NX_API_URL=http://localhost:3000
NX_API_KEY=
NX_MCP_SPEND_CEILING_HALALAS=50000

# Only used by docker compose, to initialise the database container.
NX_POSTGRES_PASSWORD=

# The image runs with NODE_ENV=production, where the environment paths for keys and
# secrets are refused. Set this to development for a local demonstration with
# NX_MASTER_KEY and NX_SECRETS, and leave it unset for anything real.
NODE_ENV=

{
  "name": "nx-verify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @nx-verify/console run typecheck",
    "test": "vitest run",
    "guards": "vitest run test/guards",
    "migrate": "pnpm --filter @nx-verify/db run migrate",
    "migrate:verify": "pnpm --filter @nx-verify/db run migrate:verify",
    "style": "bash scripts/check-style.sh",
    "design:check": "cd apps/console && node ../../verify/check-design.mjs",
    "design:shots": "node verify/shoot.mjs",
    "build:console": "pnpm --filter @nx-verify/console run build",
    "mcp": "pnpm --filter @nx-verify/mcp run start",
    "provision": "tsx scripts/provision.ts",
    "design:all": "node verify/shots-all.mjs",
    "design:compare": "node verify/compare-shots.mjs",
    "design:responsive": "node verify/check-responsive.mjs",
    "design:navigation": "node verify/check-navigation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "pg": "^8.13.1",
    "pixelmatch": "^7",
    "playwright": "^1.63.0",
    "pngjs": "^7",
    "prettier": "^3.4.2",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.28"
    }
  }
}
